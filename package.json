{
  "name": "alia-wilkinson-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender.js && node scripts/generate-sitemap.js",
    "build:validate": "vite build && node scripts/prerender.js && node scripts/generate-sitemap.js && node scripts/validate-seo.js",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "node scripts/validate-seo.js",
    "verify": "npm test && npm audit --audit-level=low && npm run build:validate"
  },
  "dependencies": {
    "@google/generative-ai": "0.24.1",
    "@vercel/analytics": "^2.0.1",
    "axios": "1.20.0",
    "framer-motion": "14.3.0",
    "html-react-parser": "6.1.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-google-recaptcha": "2.1.0",
    "react-helmet-async": "^3.0.0",
    "react-icons": "4.12.0",
    "react-router-dom": "7.18.4",
    "react-slick": "0.31.0",
    "sass": "1.105.2"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "fast-check": "^4.10.2",
    "jsdom": "^30.1.1",
    "puppeteer": "^25.13.0",
    "vite": "8.3.4",
    "vitest": "^5.0.5"
  },
  "packageManager": "npm@11.19.1"
